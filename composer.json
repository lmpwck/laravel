{
    "name": "lampwick/laravel",
    "description": "Send monitoring data from your Laravel app to lampwick over HTTPS.",
    "keywords": ["laravel", "monitoring", "lampwick", "apm"],
    "homepage": "https://lampwick.dev",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/nightwatch": "^1.24"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "ext-pcntl": "Lets lampwick:agent flush its buffer on SIGTERM/SIGINT before exiting."
    },
    "autoload": {
        "psr-4": {
            "Lampwick\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lampwick\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lampwick\\Laravel\\LampwickServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
